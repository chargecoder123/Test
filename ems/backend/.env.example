# MySQL database must exist before the API starts.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ems

# Generate a unique random value of at least 32 characters for each environment.
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# Used to create the first administrator if no ADMIN account exists yet.
# Replace both values before starting a real environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
